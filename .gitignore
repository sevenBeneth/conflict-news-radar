# ─── 依赖 ─────────────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── 构建产物 ─────────────────────────────────────────────────────────────────
**/dist/
**/.next/
**/out/

# ─── 环境变量 ─────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
frontend/.env.local

# ─── 数据库数据（原 postgres_data/ 已不再使用）────────────────────────────────
mysql_data/
*.sql.bak

# ─── 共享层同步产物（由 scripts/sync-shared.ps1 生成，勿手改）─────────────────
# 源头在 shared/，改动请改源文件后重新同步。
backend/src/shared/
workers/src/shared/

# ─── 日志 ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── 操作系统 ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── 编辑器 ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── TypeScript 增量编译产物（不应提交）─────────────────────────────────────────
*.tsbuildinfo
frontend/next-env.d.ts

# ─── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ─── 离线地图瓦片（体积大且涉及第三方版权，切勿提交）──────────────────────────
# 说明：底图瓦片受各服务商使用条款约束，本地缓存自用即可，不可随仓库分发。
frontend/public/tiles/
tiles/
*.mbtiles
*.pmtiles
# ─── 临时文件（浏览器 profile、调试脚本等），切勿提交 ─────────────────────────
.tmp-*
tmp/
*.tmp
# ─── 实验文档不入库（含实名的作业材料，仅本地保存）────────────────────────────
docs/
*.docx

# Local knowledge and experiment traces
backend/data/
backend/news-draft.json
