# ============================================================================
#  地区冲突资讯雷达 · 环境变量模板
# ----------------------------------------------------------------------------
#  用法：
#      copy .env.example .env                    # 后端 / 采集器
#      copy .env.example frontend\.env.local     # 前端
#
#  各数据源的启用状态与接入进度集中登记在数据库 data_sources 表中，
#  便于逐项推进与回退，无需改动代码即可调整。
# ============================================================================

# ─── 应用 ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=4000

# ─── 数据库：MySQL 8 ─────────────────────────────────────────────────────────
# 空间能力由 MySQL 原生 POINT 类型 + SPATIAL INDEX 承担，
# 包围盒查询使用 ST_Within + WKT 多边形（MySQL 无 ST_MakeEnvelope 函数）。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cnr
MYSQL_USER=cnr
MYSQL_PASSWORD=cnr_password
MYSQL_POOL_SIZE=10

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── 前端公开变量（浏览器可见，写入 frontend/.env.local）─────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ─── 地图底图：天地图（推荐）─────────────────────────────────────────────────
# 申请：https://console.tianditu.gov.cn/ （免费，需实名；创建应用后取「浏览器端」Key）
# 不配置时的行为：前端自动回退到免 Key 的高德矢量底图
#   · 天地图坐标系 CGCS2000 ≈ WGS-84 → 无需坐标偏移（默认选用）
#   · 高德坐标系 GCJ-02 → 前端自动启用坐标偏移（见 src/lib/coords.ts）
NEXT_PUBLIC_TIANDITU_KEY=

# ─── 高德地理编码（可选，预留）───────────────────────────────────────────────
# 用途：中文地名 → 经纬度，作为地名识别的补充
# 申请：https://lbs.amap.com/ （个人开发者有免费额度）
# 注意：高德返回 GCJ-02 坐标，写库前须用 gcj02ToWgs84() 转回 WGS-84
AMAP_WEB_KEY=

# ─── AI / Ollama（可选，本地推理，数据不出本机）──────────────────────────────
# 安装：https://ollama.com/download
# 拉取模型：ollama pull qwen2.5:7b   （中文能力较好）
# 未安装时 AI 问答功能自动降级，其余功能不受影响。
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ─── 安全 ─────────────────────────────────────────────────────────────────────
# 前端访问口令（可选；单人本地部署可留空）
ACCESS_TOKEN=

# ─── 新闻源：官方 RSS（默认）────────────────────────────────────────────────
# 选择实现：rss（默认） | gdelt（备选实现，保留以便对照）
NEWS_PROVIDER=rss

# 源列表覆盖（可选）。格式为分号分隔，每项 7 段、以竖线分隔：
#   标识|媒体名|RSS地址|分类|pubDate格式(rfc822/date)|description形态(summary/html)|启用(1/0)
#   第 7 段可省略，省略时默认启用。
#
# 留空则使用代码内置的默认源：
#   · 中新网 国际  https://www.chinanews.com.cn/rss/world.xml
#   · 中新网 要闻  https://www.chinanews.com.cn/rss/scroll-news.xml
#   · 中新网 要闻  https://www.chinanews.com.cn/rss/importnews.xml
#
# 可用源的两个差异（配置新源时需注意）：
#   · pubDate 格式：RFC-822 带时区（rfc822）或仅日期（date）
#   · description 形态：已是纯文本摘要（summary）或整篇正文 HTML（html）
#
# 示例（人民网，经实测其 RSS 已停止更新，默认不启用）：
# NEWS_RSS_SOURCES=people_world|人民网|http://www.people.com.cn/rss/world.xml|国际|date|html|1
NEWS_RSS_SOURCES=

# 数据新鲜度告警阈值（小时）。源内最新一条超过该时长即在日志告警，
# 用于发现"返回 200 但内容已停更"的静默失效源。
NEWS_STALE_WARN_HOURS=48

# ─── 其他数据域（可选，留空则走样例数据分支）────────────────────────────────
# OpenSky Network（航班 ADS-B）
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# AISStream.io（船舶 AIS）
AISSTREAM_API_KEY=

# ACLED（冲突事件库）
ACLED_API_KEY=
ACLED_EMAIL=

# ─── 采集轮询间隔（毫秒）─────────────────────────────────────────────────────
POLL_INTERVAL_AIRCRAFT=30000
POLL_INTERVAL_SHIPS=60000
POLL_INTERVAL_CONFLICTS=300000
POLL_INTERVAL_NEWS=120000

# ─── 镜像加速（可选）─────────────────────────────────────────────────────────
# npm 源已在仓库根目录 /.npmrc 预置为 registry.npmmirror.com。
# 若需在构建时覆盖 npm 源，可在此指定：
# NPM_REGISTRY=https://registry.npmmirror.com
