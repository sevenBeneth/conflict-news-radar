# ─── 国内镜像加速配置 ─────────────────────────────────────────────────────────
# 说明：本文件会被 backend/、workers/、frontend/ 三个子目录继承（npm 会向上查找）。
# 若某个子目录需要单独覆盖，可在该目录下再放一个 .npmrc。

# npmmirror（原淘宝 NPM 镜像），国内下载速度显著优于 registry.npmjs.org
registry=https://registry.npmmirror.com

# 二进制/预编译包（含原生模块）也走国内镜像
# better-sqlite3、bcrypt、sharp 等含原生扩展的包依赖此项
disturl=https://registry.npmmirror.com/-/binary/node

# node-sass / sass 类包的二进制镜像（本项目未使用，预留）
sass_binary_site=https://registry.npmmirror.com/-/binary/node-sass

# Electron 镜像（本项目未使用，预留，方便后续桌面端方案）
electron_mirror=https://registry.npmmirror.com/-/binary/electron/

# 关闭审计与资助提示，减少无关网络请求
audit=false
fund=false

# 固化为镜像源，避免受用户级 .npmrc 影响
package-lock=true
